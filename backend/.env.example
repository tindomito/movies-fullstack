# Copiar este archivo como .env y completar con tus propios valores.
# Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/movies_api?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/movies_api
MONGODB_URI=mongodb://localhost:27017/movies_api

# Cadena larga y aleatoria. No usar este valor en producción.
JWT_SECRET=cambiar_por_una_clave_aleatoria_propia

JWT_EXPIRES_IN=7d
PORT=3000
